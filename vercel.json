{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "./",
      "framework": "nextjs",
      "buildCommand": "next build",
      "installCommand": "npm install",
      "functions": {
        "app/api/[[...path]]/route.js": {
          "maxDuration": 15
        }
      }
    }
  },
  "regions": ["iad1"]
}
