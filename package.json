{
  "name": "cinescope-movie-discovery",
  "version": "1.0.0",
  "description": "A modern, responsive English Movie Discovery web application built with HTML5, SCSS, and Vanilla JavaScript.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "sass scss/main.scss css/main.css --no-source-map --style=compressed",
    "watch:css": "sass scss/main.scss css/main.css --watch",
    "seed": "node scripts/seed-mongodb.js",
    "data:generate": "node scripts/generate-movie-catalog.mjs",
    "data:validate": "node scripts/validate-movie-catalog.mjs"
  },
  "devDependencies": {
    "sass": "^1.85.0"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.5",
    "multer": "^1.4.4-lts.1",
    "serverless-http": "^4.0.0"
  }
}
