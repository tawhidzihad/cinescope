# ------------------------------------------------------------------
# CineScope environment variables (server-only — never commit real values)
# ------------------------------------------------------------------

# MongoDB connection string (required)
MONGODB_URI=

# Optional: override the database name (default: cinescope)
MONGODB_DB=cinescope

# Admin credentials (used to seed/refresh the hashed admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session signing secret (use a long random string in production)
SESSION_SECRET=

# Public site URL used for SEO metadata/canonicals (optional)
NEXT_PUBLIC_SITE_URL=