# CineScope Environment Variables
# Copy this file to .env and fill in your API credentials

# TMDB (The Movie Database) API Bearer Token
# Get yours at: https://www.themoviedb.org/settings/api
# Use the "API Read Access Token (v4 auth)" — NOT the v3 API key
TMDB_API_TOKEN=4cd06d21fa291818d93950300bd4d2af

# YouTube Data API v3 Key (optional — only if you need YouTube validation)
# Get yours at: https://console.cloud.google.com/apis/credentials
# This is only needed for the generate-movie-catalog script, never shipped to frontend
YOUTUBE_API_KEY=
